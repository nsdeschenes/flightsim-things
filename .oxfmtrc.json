{
  "bracketSpacing": false,
  "printWidth": 90,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "ignorePatterns": [
    "**/dist/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "test-results",
    "playwright-report",
    "LICENSE",
    "release"
  ]
}
