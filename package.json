{
  "name": "flightsim-things",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "imports": {
    "#acceptance-cli": "./acceptance/support/cli.ts",
    "#acceptance-scanner": "./acceptance/support/scanner.ts",
    "#invocation": "./src/invocation.ts",
    "#ai": "./src/ai.ts",
    "#find-flight": "./src/find-flight.ts",
    "#airport-enrichment": "./src/airport-enrichment.ts",
    "#package": "./package.json",
    "#sentry-config": "./src/sentry-config.ts",
    "#configuration": "./src/configuration.ts",
    "#community-path": "./src/community-path.ts",
    "#openaip-key": "./src/openaip-key.ts",
    "#database": "./src/database/index.ts",
    "#database-schema": "./src/database/schema.ts",
    "#scanner": "./src/scanner/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "bun run test:source && bun run test:acceptance",
    "test:source": "bun test",
    "test:acceptance": "bun test --cwd acceptance",
    "fix": "bun run lint:fix && bun run fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "pre-commit:run": "prek run",
    "pre-commit:install": "prek install",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "build": "bun scripts/release.ts build",
    "verify:binary": "bun scripts/release.ts smoke",
    "stage:release": "bun scripts/release.ts stage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@effect/platform-bun": "4.0.2",
    "@sentry/effect": "11.7.0",
    "ai": "^7.0.142",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@effect/tsgo": "0.51.1",
    "@j178/prek": "^0.5.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "drizzle-kit": "1.0.0-rc.4",
    "msw": "2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  }
}
