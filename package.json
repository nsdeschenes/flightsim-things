{
  "name": "flightsim-things",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "bun test",
    "fix": "bun run lint:fix && bun run fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "pre-commit:run": "prek run",
    "pre-commit:install": "prek install",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "effect": "^4.0.2"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@effect/tsgo": "0.51.1",
    "@j178/prek": "^0.5.5",
    "@types/bun": "latest",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  }
}
